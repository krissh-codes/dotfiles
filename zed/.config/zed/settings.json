{
    "base_keymap": "JetBrains",
    "confirm_quit": true,
    "format_on_save": "off",
    "preferred_line_length": 180,
    "remove_trailing_whitespace_on_save": false,
    "soft_wrap": "editor_width",
    "tab_size": 4,
    "use_on_type_format": false,
    "buffer_font_family": "Liga MesloLGM Nerd Font",
    "buffer_font_features": {
        "liga": true
    },
    "buffer_font_size": 12.0,
    "ui_font_family": "Plus Jakarta Sans",
    "ui_font_size": 15.0,
    "features": {
        "edit_prediction_provider": "zed"
    },
    "icon_theme": {
        "dark": "Colored Zed Icons Theme Dark",
        "light": "Colored Zed Icons Theme Light"
    },
    "theme": {
        "dark": "Nordfox - blurred",
        "light": "Dawnfox - blurred",
        "mode": "system"
    },
    "outline_panel": {
        "auto_fold_dirs": true,
        "dock": "right"
    },
    "project_panel": {
        "dock": "right"
    },
    "tab_bar": {
        "show": true,
        "show_nav_history_buttons": false
    },
    "terminal": {
        "copy_on_select": true,
        "font_fallbacks": ["FiraCode Nerd Font"],
        "font_family": "Liga MesloLGM Nerd Font",
        "font_features": {
            "liga": false
        },
        "font_size": 12.0,
        "toolbar": {
            "breadcrumbs": false
        }
    },
    "toolbar": {
        "breadcrumbs": false,
        "quick_actions": false
    }
}
